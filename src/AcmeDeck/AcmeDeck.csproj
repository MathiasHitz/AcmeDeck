<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>AcmeDeck</RootNamespace>
    <AssemblyName>AcmeDeck</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AcmeDeck.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>AcmeDeck</Product>
    <Authors>AcmeDeck contributors</Authors>
    <Copyright>Copyright (c) 2026 AcmeDeck contributors</Copyright>
    <Description>Graphical front end for win-acme to manage Let's Encrypt certificates in IIS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Generated by tools\IconGen -->
    <Resource Include="Assets\AcmeDeck.ico" />
    <Resource Include="Assets\AcmeDeck-64.png" />
    <None Include="Assets\AcmeDeck-256.png" />
  </ItemGroup>

</Project>
