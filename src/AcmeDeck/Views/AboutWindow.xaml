<Window x:Class="AcmeDeck.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About AcmeDeck" Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel>
        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/AcmeDeck;component/Assets/AcmeDeck-64.png"
                       Width="64" Height="64" VerticalAlignment="Top" Margin="0,0,18,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="AcmeDeck" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Muted}" Margin="0,2,0,10" />
                    <TextBlock TextWrapping="Wrap"
                               Text="A graphical front end for win-acme to manage Let's Encrypt certificates in IIS." />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Margin="28,18,28,8">
            <HeaderedContentControl Header="Author" Style="{StaticResource Field}">
                <TextBlock x:Name="AuthorText" FontWeight="SemiBold" />
            </HeaderedContentControl>
            <HeaderedContentControl Header="License" Style="{StaticResource Field}">
                <TextBlock TextWrapping="Wrap">
                    <Run x:Name="CopyrightRun" />
                    <LineBreak />
                    <Hyperlink Click="OnShowLicense">MIT License</Hyperlink>
                </TextBlock>
            </HeaderedContentControl>
            <HeaderedContentControl Header="Built on" Style="{StaticResource Field}">
                <TextBlock TextWrapping="Wrap">
                    <Hyperlink NavigateUri="https://www.win-acme.com/" RequestNavigate="OnNavigate">win-acme</Hyperlink>
                    <Run Text="by the win-acme contributors (Apache License 2.0), which does all the certificate work, and" />
                    <Hyperlink NavigateUri="https://letsencrypt.org/" RequestNavigate="OnNavigate">Let's Encrypt</Hyperlink><Run Text="." />
                </TextBlock>
            </HeaderedContentControl>
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                       Text="AcmeDeck is an independent project and not affiliated with win-acme or Let's Encrypt." />
        </StackPanel>

        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="28,12" Margin="0,10,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}" />
        </Border>
    </StackPanel>
</Window>
