<Window x:Class="AcmeDeck.Views.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="900" Height="560" MinWidth="600" MinHeight="360"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" />
            <TextBlock x:Name="CommandText" Style="{StaticResource Muted}" Margin="0,4,0,12"
                       FontFamily="{StaticResource MonoFont}" FontSize="12" />
        </StackPanel>

        <Border Grid.Row="1" CornerRadius="6" Background="#1E1F22" Padding="2">
            <TextBox x:Name="OutputBox" IsReadOnly="True" Background="Transparent" Foreground="#D9DDE3"
                     BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" Padding="10,8" VerticalContentAlignment="Top" />
        </Border>

        <Border Grid.Row="2" x:Name="ResultBanner" Margin="0,12,0,0" CornerRadius="6" Padding="12,10"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="26" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ResultDot" Width="18" Height="18" CornerRadius="9" VerticalAlignment="Top">
                    <TextBlock x:Name="ResultSymbol" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" x:Name="ResultText" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel x:Name="RunningPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="140" Height="4" />
                <TextBlock Text="Running…" Margin="10,0,0,0" Style="{StaticResource Muted}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Content="Copy output" Click="OnCopy" Margin="0,0,8,0" />
                <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
                <Button x:Name="CloseButton" Content="Close" Click="OnClose" Style="{StaticResource PrimaryButton}"
                        Visibility="Collapsed" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
