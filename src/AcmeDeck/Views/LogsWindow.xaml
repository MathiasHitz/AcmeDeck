<Window x:Class="AcmeDeck.Views.LogsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="win-acme logs" Style="{StaticResource AppWindow}"
        Width="1100" Height="700" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Folder}" Style="{StaticResource Muted}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox Content="Only warnings and errors" IsChecked="{Binding OnlyProblems}" Margin="0,0,16,0" />
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" Width="200"
                         ToolTip="Filter lines" Margin="0,0,8,0" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding Selected}"
                 BorderBrush="{StaticResource BorderBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Info}" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" Grid.Column="2" CornerRadius="6" Background="#1E1F22" Padding="2">
            <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True" Background="Transparent"
                     Foreground="#D9DDE3" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                     Padding="10,8" VerticalContentAlignment="Top" />
        </Border>
    </Grid>
</Window>
