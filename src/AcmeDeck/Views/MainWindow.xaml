<Window x:Class="AcmeDeck.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AcmeDeck" Style="{StaticResource AppWindow}"
        Width="1320" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Colored dot + text, used for the status column -->
        <DataTemplate x:Key="StatusCell">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center"
                         Fill="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="pack://application:,,,/AcmeDeck;component/Assets/AcmeDeck-64.png"
                       Width="38" Height="38" VerticalAlignment="Center" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="AcmeDeck" Style="{StaticResource Heading}" />
                    <TextBlock Text="{Binding EnvironmentText}" Style="{StaticResource Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="New certificate" Command="{Binding NewCertificateCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,0" />
                    <Button Content="Logs" Command="{Binding OpenLogsCommand}" Margin="0,0,8,0" />
                    <Button Content="Settings" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0" />
                    <Button Content="About" Command="{Binding OpenAboutCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding TaskText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap" />
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Health banners -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Health}" Margin="20,14,20,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Level, Converter={StaticResource LevelToBackground}}"
                            CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CheckLine}" />
                            <Button Grid.Column="1" Content="{Binding ActionText}" Command="{Binding Action}"
                                    Margin="16,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding ActionText, Converter={StaticResource HasValue}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TabControl Margin="20,10,20,14" SelectedIndex="{Binding SelectedTab}" Padding="0,10,0,0"
                    Background="Transparent" BorderThickness="0">

            <!-- ============ Certificates ============ -->
            <TabItem Header="Certificates">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*" MinWidth="420" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="9*" MinWidth="380" />
                    </Grid.ColumnDefinitions>

                    <DataGrid ItemsSource="{Binding Certificates}" SelectedItem="{Binding Selected}"
                              Style="{StaticResource ListGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="130" CellTemplate="{StaticResource StatusCell}"
                                                    SortMemberPath="Level" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Host names" Binding="{Binding HostsText}" Width="3*" />
                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresText}" Width="150"
                                                SortMemberPath="Expires" />
                            <DataGridTextColumn Header="Next renewal" Binding="{Binding NextRenewalText}" Width="100"
                                                SortMemberPath="NextRenewal" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding Certificates.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}">
                        <TextBlock Text="No certificates yet" Style="{StaticResource SectionHeading}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Request a certificate for an IIS site, or take over an existing binding on the 'IIS bindings' tab."
                                   Style="{StaticResource Muted}" TextAlignment="Center" MaxWidth="320" Margin="0,0,0,12" />
                        <Button Content="New certificate" Command="{Binding NewCertificateCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Stretch" Background="Transparent" />

                    <!-- Details -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding Selected, Converter={StaticResource HasValue}}">
                        <StackPanel DataContext="{Binding Selected}">

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}"
                                                   TextWrapping="Wrap" />
                                        <Border Grid.Column="1" Style="{StaticResource Chip}" Margin="12,0,0,0"
                                                Background="{Binding Level, Converter={StaticResource LevelToBackground}}">
                                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold"
                                                       Foreground="{Binding Level, Converter={StaticResource LevelToBrush}}" />
                                        </Border>
                                    </Grid>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Renew now" Margin="0,0,8,6"
                                                Command="{Binding DataContext.RenewCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Change host names" Margin="0,0,8,6"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0,0,8,6"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Button Content="Revoke" Style="{StaticResource DangerButton}" Margin="0,0,8,6"
                                                Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </WrapPanel>
                                    <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource CheckLine}"
                                                  Margin="0,8,0,0"
                                                  Visibility="{Binding Issues, Converter={StaticResource HasValue}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Certificate" Style="{StaticResource SectionHeading}" />
                                    <HeaderedContentControl Header="Host names" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding CertificateNamesText}" TextWrapping="Wrap" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Valid" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding CertificateValidityText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Issuer" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding Certificate.Issuer, FallbackValue=-, TargetNullValue=-}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Thumbprint" Style="{StaticResource Field}">
                                        <TextBox Text="{Binding Renewal.LastThumbprint, Mode=OneWay, TargetNullValue=-}"
                                                 Style="{StaticResource MonoValue}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Location" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding CertificateLocationText}" TextWrapping="Wrap" />
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Bindings in IIS" Style="{StaticResource SectionHeading}" />
                                    <ItemsControl ItemsSource="{Binding BindingChecks}" ItemTemplate="{StaticResource CheckLine}" />
                                    <Button Content="Check again" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding DataContext.CheckBindingsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Public DNS" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                               Text="What Let's Encrypt sees, independent of local DNS servers or hosts entries on this network." />
                                    <ItemsControl ItemsSource="{Binding DnsChecks}" ItemTemplate="{StaticResource CheckLine}" />
                                    <Button Content="Check public DNS" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Command="{Binding DataContext.CheckDnsCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Configuration" Style="{StaticResource SectionHeading}" />
                                    <HeaderedContentControl Header="IIS site" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding SitesText}" TextWrapping="Wrap" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Host filter" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding HostFilterText}" TextWrapping="Wrap" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Next order contains" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding EffectiveHostsText}" TextWrapping="Wrap" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Validation" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding ValidationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Store" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding StoreText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Installation" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding InstallationText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Next renewal" Style="{StaticResource Field}">
                                        <TextBlock Text="{Binding NextRenewalText}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Equivalent options" Style="{StaticResource Field}">
                                        <TextBox Text="{Binding CommandText, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Renewal id" Style="{StaticResource Field}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding Renewal.Id, Mode=OneWay}" Style="{StaticResource MonoValue}" />
                                            <Button Content="Show file" Style="{StaticResource LinkButton}" Margin="12,2,0,0"
                                                    Command="{Binding DataContext.OpenRenewalFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </HeaderedContentControl>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="History" Style="{StaticResource SectionHeading}" />
                                    <TextBlock Text="No runs recorded." Style="{StaticResource Muted}"
                                               Visibility="{Binding History.Count, Converter={StaticResource HasValue}, ConverterParameter=invert}" />
                                    <ItemsControl ItemsSource="{Binding History}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="130" />
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy HH:mm}"
                                                               Style="{StaticResource Muted}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ResultText}" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Success}" Value="True">
                                                                        <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============ IIS bindings ============ -->
            <TabItem Header="IIS bindings">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                                   Text="All HTTPS bindings with the certificate IIS actually serves. Certificates from other tools or purchased ones show as 'Not managed' and can be taken over by win-acme." />
                        <Button Grid.Column="1" Content="Check again" Command="{Binding CheckAllBindingsCommand}" Margin="16,0,0,0" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Bindings}" Style="{StaticResource ListGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Status" Width="130" CellTemplate="{StaticResource StatusCell}"
                                                    SortMemberPath="Level" />
                            <DataGridTextColumn Header="Site" Binding="{Binding SiteName}" Width="*" />
                            <DataGridTextColumn Header="Host name" Binding="{Binding Host}" Width="2*" />
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="120" />
                            <DataGridTextColumn Header="Issuer" Binding="{Binding IssuerText}" Width="*" />
                            <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresText}" Width="150" />
                            <DataGridTextColumn Header="Managed by" Binding="{Binding ManagedByText}" Width="1.5*" />
                            <DataGridTemplateColumn Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Take over" Padding="10,2" MinHeight="24"
                                                Command="{Binding DataContext.TakeOverCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanTakeOver, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
